  "strip": [
    "\\s*-\\s*(Google )?Chrome$",
    "\\s*-\\s*프로필 \\d+\\s*-\\s*Microsoft Edge$",
    "\\s*-\\s*Microsoft Edge$",
    "\\s*-\\s*Personal$",
    "\\s*외 페이지 \\d+개",
    "^\\(\\d+\\)\\s*",
    "\\s*[-·|]\\s*Chrome$",
    "^Google Chrome$",
    "^Microsoft Edge$"
  ],
